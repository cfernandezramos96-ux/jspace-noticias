# Copia este archivo como .env (en esta misma carpeta) y pega el token de Instagram de @jspaceco_.
# El token sale del panel de la app de Meta: Instagram → API setup with Instagram login → Generate token.
# No lo compartas ni lo pegues en el chat.
IG_TOKEN=
# Lo rellena solo `node scripts/publicar.mjs --cuenta`
# IG_USER_ID=

# Cloudinary (Dashboard → API Keys): donde se suben las imágenes para que Instagram las lea
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
